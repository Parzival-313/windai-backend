# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres container (docker-compose uses these to build DATABASE_URL) ---
POSTGRES_USER=aeolus
POSTGRES_PASSWORD=
POSTGRES_DB=aeolus

# --- Database ---
# Empty  -> use the local Docker Postgres (`db` service).
# Hosted -> paste the full one-line URL, e.g. Neon's "Connection string" (direct, not pooled):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# A plain postgresql:// URL is fine; the app switches it to the psycopg 3 driver.
DATABASE_URL=

# Compose always uses its own `redis` service; this is only for running outside Docker.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# At least 32 characters. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Per client IP, for POST /auth/login and /auth/change-password (`limits` syntax).
LOGIN_RATE_LIMIT=5/minute
# Optional first-start bootstrap: if the user table is empty when the API starts, this
# admin is created once. Prefer the CLI instead (see README). Remove the password after.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS: comma-separated browser origins allowed to call the API ('*' is rejected) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Storage (paths inside the container; compose sets these) ---
DATA_DIR=/data/raw
CACHE_DIR=/data/cache
MODEL_DIR=/data/models
ARTIFACT_DIR=/data/artifacts

# --- Host-side settings for docker-compose ---
# Folder on your PC with the raw datasets (ERA5, GEBCO, indices). Mounted read-only.
HOST_DATA_DIR=./data
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
