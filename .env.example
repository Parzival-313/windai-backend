# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres container (docker-compose uses these to build DATABASE_URL) ---
POSTGRES_USER=aeolus
POSTGRES_PASSWORD=
POSTGRES_DB=aeolus

# Only used when running the app outside Docker (compose overrides both).
DATABASE_URL=postgresql+psycopg://aeolus:CHANGE_ME@localhost:5433/aeolus
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# At least 32 characters. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Optional first-start bootstrap (Step 1). Remove the password after the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS: comma-separated browser origins allowed to call the API ('*' is rejected) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Storage (paths inside the container; compose sets these) ---
DATA_DIR=/data/raw
CACHE_DIR=/data/cache
MODEL_DIR=/data/models
ARTIFACT_DIR=/data/artifacts

# --- Host-side settings for docker-compose ---
# Folder on your PC with the raw datasets (ERA5, GEBCO, indices). Mounted read-only.
HOST_DATA_DIR=./data
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
