{
  "info": {
    "name": "AEOLUS API",
    "description": "Manual-test collection for the AEOLUS backend. Select the 'AEOLUS local' environment. One folder per domain, one request per endpoint. Full instructions per domain: docs/api/<domain>.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "No auth. 200 + status 'ok' when Postgres/PostGIS and Redis are reachable; 503 + 'degraded' otherwise."
          }
        }
      ],
      "description": "Docs: docs/api/health.md."
    },
    {
      "name": "Authentication",
      "description": "Docs: docs/api/auth.md. Create the admin first (terminal): docker compose exec api python -m app.cli create-admin — then fill adminEmail and adminPassword in the environment and send Login; it stores accessToken and refreshToken for the other requests.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns accessToken + refreshToken (saved automatically). Rate-limited: 5 per minute per IP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.environment.set('accessToken', b.accessToken);",
                  "  pm.environment.set('refreshToken', b.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "New token pair; the old refresh token stops working."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.environment.set('accessToken', b.accessToken);",
                  "  pm.environment.set('refreshToken', b.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "change-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{newAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "204. Revokes all refresh tokens (every device logs out). Put the new password in newAdminPassword first; afterwards copy it into adminPassword."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "204. Revokes the refresh token."
          }
        }
      ]
    },
    {
      "name": "Turbine Classes",
      "description": "Docs: docs/api/turbines.md. Read-only reference data (g36, g45, g62). Send Login first.",
      "item": [
        {
          "name": "List Turbine Classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/turbine-classes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "turbine-classes"
              ]
            },
            "description": "All classes, smallest first (g36, g45, g62). Field names are the frontend's MODELS keys."
          }
        },
        {
          "name": "Get Turbine Class",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/turbine-classes/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "turbine-classes",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "g45"
                }
              ]
            },
            "description": "One class by id (g36, g45 or g62; case-sensitive). Unknown id -> 404 TURBINE_CLASS_NOT_FOUND."
          }
        },
        {
          "name": "Get Power Curve",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/turbine-classes/:id/power-curve?step=0.5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "turbine-classes",
                ":id",
                "power-curve"
              ],
              "query": [
                {
                  "key": "step",
                  "value": "0.5"
                }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "g45"
                }
              ]
            },
            "description": "[{speed, powerKw, ct}] from 0 to 30 m/s. step 0.1-5 (default 0.5)."
          }
        }
      ]
    }
  ]
}
